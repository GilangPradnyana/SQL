/* ================= BAGIAN 2 ================= */
-- Catatan: kode di bawah mengikuti soal (MK01, MK02, MK03).
-- Jika data Anda memakai A01, A02, A03, ganti kodenya.

-- SOAL 4: nilai TERTINGGI di MK02
SELECT m.namaMhs, a.nilai
FROM tb_ambilmk a
JOIN tb_mhs m ON m.nim = a.nim
WHERE a.kodeMK = 'MK02'
  AND a.nilai = (SELECT MAX(nilai) FROM tb_ambilmk WHERE kodeMK = 'MK02');

-- SOAL 5: di MK03, nilai DI ATAS rata-rata
SELECT m.nim, m.namaMhs
FROM tb_ambilmk a
JOIN tb_mhs m ON m.nim = a.nim
WHERE a.kodeMK = 'MK03'
  AND a.nilai > (SELECT AVG(nilai) FROM tb_ambilmk WHERE kodeMK = 'MK03');

-- SOAL 6: mahasiswa yang TIDAK mengambil MK01
SELECT m.namaMhs
FROM tb_mhs m
WHERE NOT EXISTS (SELECT 1 FROM tb_ambilmk a
                  WHERE a.nim = m.nim AND a.kodeMK = 'MK01');

-- SOAL 7: nilai terendah mahasiswa bernama RAHMA
SELECT MIN(a.nilai) AS nilai_terendah
FROM tb_ambilmk a
JOIN tb_mhs m ON m.nim = a.nim
WHERE m.namaMhs = 'RAHMA';

-- SOAL 8: mahasiswa yang mengambil MK01
SELECT m.namaMhs
FROM tb_mhs m
JOIN tb_ambilmk a ON a.nim = m.nim
WHERE a.kodeMK = 'MK01';

-- SOAL 9: di MK01, nilai DI BAWAH rata-rata
SELECT m.nim, m.namaMhs
FROM tb_ambilmk a
JOIN tb_mhs m ON m.nim = a.nim
WHERE a.kodeMK = 'MK01'
  AND a.nilai < (SELECT AVG(nilai) FROM tb_ambilmk WHERE kodeMK = 'MK01');

-- SOAL 10: mahasiswa dengan nilai = 4
SELECT DISTINCT m.namaMhs
FROM tb_mhs m
JOIN tb_ambilmk a ON a.nim = m.nim
WHERE a.nilai = 4;

-- SOAL 11: nilai TERENDAH di MK03
SELECT m.namaMhs, a.nilai
FROM tb_ambilmk a
JOIN tb_mhs m ON m.nim = a.nim
WHERE a.kodeMK = 'MK03'
  AND a.nilai = (SELECT MIN(nilai) FROM tb_ambilmk WHERE kodeMK = 'MK03');

-- SOAL 12: mahasiswa yang mengambil mata kuliah KALKULUS
SELECT m.namaMhs
FROM tb_mhs m
JOIN tb_ambilmk a ON a.nim    = m.nim
JOIN tb_mk      k ON k.kodeMK = a.kodeMK
WHERE k.namaMK = 'Kalkulus';
