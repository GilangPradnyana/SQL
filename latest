USE uts;

/* ================= BAGIAN 1 ================= */

-- SOAL 1: barang yang terjual secara kredit
SELECT b.id_barang,
       b.nama_barang,
       SUBSTRING_INDEX(SUBSTRING_INDEX(t.detil_trx, '-', 2), '-', -1) AS jenis_pembayaran
FROM transaksi t
JOIN barang b ON b.id_barang = SUBSTRING_INDEX(t.detil_trx, '-', 1)
WHERE t.detil_trx LIKE '%-Credit%';

-- SOAL 2: transaksi beserta nama kasir
SELECT t.id_trx, t.tgl_trx, t.detil_trx, k.nama_kasir
FROM transaksi t
JOIN kasir k ON k.id_kasir = t.id_kasir;

-- SOAL 3: transaksi dengan nama barang dan kasir
SELECT t.id_trx, t.tgl_trx, b.nama_barang, t.detil_trx, k.nama_kasir
FROM transaksi t
JOIN kasir  k ON k.id_kasir  = t.id_kasir
JOIN barang b ON b.id_barang = SUBSTRING_INDEX(t.detil_trx, '-', 1);


/* ================= SETUP BAGIAN 2 ================= */

CREATE TABLE IF NOT EXISTS tb_mhs (
  nim VARCHAR(5) NOT NULL,
  namaMhs VARCHAR(30),
  PRIMARY KEY (nim)
);

CREATE TABLE IF NOT EXISTS tb_mk (
  kodeMK VARCHAR(5) NOT NULL,
  namaMK VARCHAR(30),
  sks INT,
  PRIMARY KEY (kodeMK)
);

CREATE TABLE IF NOT EXISTS tb_ambilmk (
  nim VARCHAR(5),
  kodeMK VARCHAR(5),
  nilai INT
);

